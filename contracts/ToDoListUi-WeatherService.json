    {
      "description": "GET /forecast: GetForecastSummary",
      "key": "e1416f3d",
      "pending": false,
      "providerStates": [
        {
          "name": "ForecastExist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/forecast"
      },
      "response": {
        "body": {
          "content": [
            {
              "detailedForecast": "Mostly clear, with a low around 19. North northwest wind 5 to 15 mph, with gusts as high as 30 mph.",
              "name": "Tonight",
              "temperature": 19,
              "windSpeed": "5 to 15 mph"
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].detailedForecast": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].temperature": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[*].windSpeed": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
